os: mac
mode: command
mode: dictation
-

^(clean shot|screenshot) (target|here)$: key(cmd-shift-1)
^(clean shot|screenshot) (recapture|recap|again)$: key(cmd-shift-2)
^(clean shot|screenshot)$: key(cmd-shift-3)
^(clean shot|screenshot) (full|fullscreen)$: key(cmd-shift-4)
^(clean shot|screenshot) (win|window|app)$: key(cmd-shift-5)
^(clean shot|screenshot) (timer|time|timed)$: key(cmd-shift-6)
^(clean shot|screenshot) (wreck|record|video)$: key(cmd-shift-7)
^(clean shot|screenshot) scroll$: key(cmd-shift-8)
^(clean shot|screenshot) (last|prev)$: key(cmd-shift-9)
^(clean shot|screenshot) scrape$: key(cmd-shift-0)