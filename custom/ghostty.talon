os: mac
app: Ghostty
-
close claude:
    insert('/exit')
    sleep(100ms)
    key(enter)
    sleep(500ms)
    insert('exit')
    key(enter)
    sleep(500ms)
    insert('exit')
    key(enter)

close container claude:
    insert('/exit')
    sleep(100ms)
    key(enter)
    sleep(500ms)
    insert('exit')
    key(enter)
    sleep(500ms)
    insert('exit')
    key(enter)
    sleep(500ms)
    insert('exit')
    key(enter)
